{
  "manifest_version": 3,
  "name": "ThreatDefender AI",
  "version": "1.0.0",
  "description": "Local-first phishing and scam protection. Pages are checked by the ThreatDefender engine running on your own computer.",
  "permissions": ["webNavigation", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ThreatDefender AI" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
