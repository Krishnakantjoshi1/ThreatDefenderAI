# Copy to .env and edit. Every value is optional.
TD_HOST=127.0.0.1
TD_PORT=8000

# Local AI (Ollama must run on THIS computer - remote addresses are refused for privacy)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3
OLLAMA_TIMEOUT=90

# Optional: Google Safe Browsing API key (used only in ONLINE mode)
SAFE_BROWSING_KEY=
